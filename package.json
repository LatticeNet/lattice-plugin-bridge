{
  "name": "@latticenet/plugin-bridge",
  "version": "0.1.0-alpha.1",
  "description": "The one Lattice plugin-UI bridge client: nonce handshake, exact-origin pinning, call transport, typed errors. Replaces the per-plugin bridge.ts copies.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
